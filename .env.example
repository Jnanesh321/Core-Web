# Database Configuration
# Prisma connects using DATABASE_URL. In serverless/pooled environments (Neon/Supabase), provide DIRECT_URL for migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/core_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/core_dev?schema=public"
# Optional shadow database URL when database user lacks CREATEDB privileges:
# SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/core_dev?schema=shadow"

# Authentication (Auth.js / NextAuth)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-byte-hex-secret-in-production"

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# VCET Cells AMS Integration (Optional - falls back to LocalStudentDirectory if false/unset)
CELLS_ENABLED="false"
CELLS_API_URL=""
CELLS_API_KEY=""
